# Copy to .env in this same directory and fill in real values.
# docker/.env is gitignored — never commit secrets.

# ---- App / network ----
WEB_ORIGIN=http://192.168.50.147:3000
API_KEY=
WEB_PUBLISH_PORT=3000
API_PUBLISH_PORT=4000
TRUST_PROXY=

# ---- AI: DeepSeek (preferred) ----
# Anthropic SDK talks to DeepSeek when DEEPSEEK_API_KEY is set.
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

# ---- AI: Anthropic Claude (optional fallback) ----
ANTHROPIC_API_KEY=
ANTHROPIC_BASE_URL=
ANTHROPIC_MODEL=

# ---- NAS ops (not injected into containers; used by deploy scripts) ----
NAS_SSH_HOST=192.168.50.147
NAS_SSH_PORT=36000
NAS_SSH_USER=redwood9
NAS_SSH_PASSWORD=
